# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit real values.

# --- Core -------------------------------------------------------------------
DATABASE_URL=
NEXTAUTH_SECRET=            # long random string: openssl rand -base64 32
NEXTAUTH_URL=https://3dtitans.org
NEXT_PUBLIC_APP_URL=https://3dtitans.org

# --- Supabase storage (uploads + private payment screenshots) ---------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sham Cash API (automatic payment confirmation) -------------------------
SHAMCASH_BASE_URL=          # the Base URL you were given, e.g. https://api.shamcash-api.com/v1
SHAMCASH_SECRET_KEY=        # the Secret Key / API token (sent as "Authorization: Bearer ...")
SHAMCASH_AGENT_KEY=         # the Agent Key (not used by the documented v1 API; kept for your provider)
SHAMCASH_ACCOUNT_ID=        # optional — only if more than one wallet is linked

# --- Cron (optional): lets a scheduler call /api/payments/shamcash/reconcile -
CRON_SECRET=

# --- Email (order + payment notifications, password reset) ------------------
RESEND_API_KEY=
EMAIL_FROM="3D Titans <noreply@3dtitans.org>"
ADMIN_NOTIFY_EMAIL=         # comma-separated admin addresses for new-order / proof alerts

# --- Google login (optional) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (optional, international cards; not usable with SYP) ------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
