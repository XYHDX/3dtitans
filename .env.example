# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables (Production and Preview
# separately — previews must use a test database and ShamCash sandbox keys).
# NEVER commit real values. Comments stay on their own lines so Vercel's
# "Import .env" works. Never set NODE_ENV yourself.

# --- Core -------------------------------------------------------------------
# Supabase TRANSACTION pooler (port 6543). Copy it from Supabase → Connect →
# ORMs → Prisma, URL-encode the password, and keep these parameters:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20
# (The direct db.<ref>.supabase.co host is IPv6-only and unreachable from Vercel.)
DATABASE_URL=
# Long random string: openssl rand -base64 32 (different value per environment)
NEXTAUTH_SECRET=
# Production only. Leave unset on Preview (Vercel's URL is used automatically).
NEXTAUTH_URL=https://3dtitans.org
NEXT_PUBLIC_APP_URL=https://3dtitans.org

# --- Supabase storage (uploads, product images, private payment proofs) -----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
# Server-only. Mark as Sensitive in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- ShamCash Electronic Payment (e-pay) — official ShamCash API -------------
# Issued by ShamCash when your service is created. SERVER-SIDE ONLY: never
# prefix these with NEXT_PUBLIC_. See docs/shamcash-epay.md.
# Sandbox: https://dev.shamlogix.tech/services — production: the URL ShamCash gives you.
SHAMCASH_BASE_URL=
# agentKey — identifies 3D Titans to ShamCash
SHAMCASH_AGENT_KEY=
# secretKey — Base64 string of exactly 32 bytes (the AES-256 key). Paste as given. Sensitive.
SHAMCASH_SECRET_KEY=

# --- Scheduled jobs ---------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to
# /api/payments/shamcash/reconcile (see vercel.json). Random string. Sensitive.
CRON_SECRET=

# --- Email (order + payment notifications, password reset) ------------------
RESEND_API_KEY=
# No surrounding quotes when entered in Vercel. The domain must be verified in Resend.
EMAIL_FROM=3D Titans <noreply@3dtitans.org>
# Comma-separated admin addresses for new-order / payment alerts
ADMIN_NOTIFY_EMAIL=

# --- Campaign analytics (optional; tags load only when set) ------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook/Instagram) Pixel ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google login (optional) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (optional, international cards; offered only when the store currency is USD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
